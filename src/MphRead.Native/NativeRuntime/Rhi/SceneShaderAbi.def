// Backend-neutral logical scene shader contract. No byte offsets or native API types.
// Included with RHI_SCENE_BINDING / CONSTANT / TEXTURE defined by its consumer.
RHI_SCENE_BINDING(Frame, Frame, 0, UniformBuffer, "frame")
RHI_SCENE_BINDING(Light, Frame, 1, UniformBuffer, "light")
RHI_SCENE_BINDING(Fog, Frame, 2, UniformBuffer, "fog")
RHI_SCENE_BINDING(Material, Material, 0, UniformBuffer, "material")
RHI_SCENE_BINDING(MaterialTexture, Material, 1, SampledTexture, "material-texture")
RHI_SCENE_BINDING(MaterialSampler, Material, 2, Sampler, "material-sampler")
RHI_SCENE_BINDING(Draw, Draw, 0, UniformBuffer, "draw")
RHI_SCENE_BINDING(DrawSmall, Draw, 1, SmallConstants, "draw-small")
RHI_SCENE_BINDING(Cel, Post, 0, UniformBuffer, "cel")
RHI_SCENE_BINDING(Hud, Post, 1, UniformBuffer, "hud")
RHI_SCENE_BINDING(Disruption, Post, 2, UniformBuffer, "disruption")
RHI_SCENE_BINDING(DisruptionTables, Post, 3, UniformBuffer, "disruption-tables")
RHI_SCENE_BINDING(PostTexture, Post, 4, SampledTexture, "post-texture")
RHI_SCENE_BINDING(PostSampler, Post, 5, Sampler, "post-sampler")
RHI_SCENE_BINDING(PostAuxTexture, Post, 6, SampledTexture, "post-aux-texture")
RHI_SCENE_BINDING(PostAuxSampler, Post, 7, Sampler, "post-aux-sampler")
RHI_SCENE_BINDING(Backdrop, Post, 8, UniformBuffer, "backdrop")

RHI_SCENE_CONSTANT("main", "use_light", Bool, 0, Material)
RHI_SCENE_CONSTANT("main", "use_texture", Bool, 0, Material)
RHI_SCENE_CONSTANT("main", "show_colors", Bool, 0, Frame)
RHI_SCENE_CONSTANT("main", "fog_enable", Bool, 0, Fog)
RHI_SCENE_CONSTANT("main", "light1vec", Vec3, 0, Light)
RHI_SCENE_CONSTANT("main", "light1col", Vec3, 0, Light)
RHI_SCENE_CONSTANT("main", "light2vec", Vec3, 0, Light)
RHI_SCENE_CONSTANT("main", "light2col", Vec3, 0, Light)
RHI_SCENE_CONSTANT("main", "diffuse", Vec3, 0, Material)
RHI_SCENE_CONSTANT("main", "ambient", Vec3, 0, Material)
RHI_SCENE_CONSTANT("main", "specular", Vec3, 0, Material)
RHI_SCENE_CONSTANT("main", "emission", Vec3, 0, Material)
RHI_SCENE_CONSTANT("main", "fog_color", Vec4, 0, Fog)
RHI_SCENE_CONSTANT("main", "far_plane", Float, 0, Frame)
RHI_SCENE_CONSTANT("main", "proj_mtx", Mat4, 0, Frame)
RHI_SCENE_CONSTANT("main", "view_mtx", Mat4, 0, Frame)
RHI_SCENE_CONSTANT("main", "view_inv_mtx", Mat4, 0, Draw)
RHI_SCENE_CONSTANT("main", "tex_mtx", Mat4, 0, Material)
RHI_SCENE_CONSTANT("main", "texgen_mode", Int, 0, Material)
RHI_SCENE_CONSTANT("main", "mtx_stack", Mat4, 32, Draw)
RHI_SCENE_CONSTANT("main", "fog_min", Float, 0, Fog)
RHI_SCENE_CONSTANT("main", "fog_max", Float, 0, Fog)
RHI_SCENE_TEXTURE("main", "tex", MaterialTexture, MaterialSampler, 0)
RHI_SCENE_CONSTANT("main", "use_override", Bool, 0, Material)
RHI_SCENE_CONSTANT("main", "override_color", Vec4, 0, Material)
RHI_SCENE_CONSTANT("main", "use_pal_override", Bool, 0, Material)
RHI_SCENE_CONSTANT("main", "pal_override_color", Vec4, 0, Material)
RHI_SCENE_CONSTANT("main", "mat_alpha", Float, 0, DrawSmall)
RHI_SCENE_CONSTANT("main", "mat_mode", Int, 0, Material)
RHI_SCENE_CONSTANT("main", "toon_table", Vec3, 32, Material)
RHI_SCENE_CONSTANT("main", "cel_bands", Int, 0, Material)
RHI_SCENE_CONSTANT("main", "alpha_test", Int, 0, DrawSmall)
RHI_SCENE_CONSTANT("main", "use_flat", Bool, 0, Material)
RHI_SCENE_CONSTANT("main", "flat_color", Vec3, 0, Material)

RHI_SCENE_CONSTANT("composite", "alpha", Float, 0, Hud)
RHI_SCENE_CONSTANT("composite", "use_mask", Bool, 0, Hud)
RHI_SCENE_CONSTANT("composite", "view_width", Float, 0, Hud)
RHI_SCENE_CONSTANT("composite", "view_height", Float, 0, Hud)
RHI_SCENE_CONSTANT("composite", "fade_color", Vec4, 0, Hud)
RHI_SCENE_TEXTURE("composite", "tex", PostTexture, PostSampler, 0)
RHI_SCENE_TEXTURE("composite", "mask", PostAuxTexture, PostAuxSampler, 1)

RHI_SCENE_TEXTURE("cel", "tex", PostTexture, PostSampler, 0)
RHI_SCENE_TEXTURE("cel", "depth_tex", PostAuxTexture, PostAuxSampler, 1)
RHI_SCENE_CONSTANT("cel", "texel_w", Float, 0, Cel)
RHI_SCENE_CONSTANT("cel", "texel_h", Float, 0, Cel)
RHI_SCENE_CONSTANT("cel", "outline", Float, 0, Cel)
RHI_SCENE_CONSTANT("cel", "near_plane", Float, 0, Cel)
RHI_SCENE_CONSTANT("cel", "far_plane", Float, 0, Cel)
RHI_SCENE_CONSTANT("cel", "depth_quantum", Float, 0, Cel)
RHI_SCENE_CONSTANT("cel", "probe", Int, 0, Cel)

RHI_SCENE_CONSTANT("shift", "shift_table", Float, 64, DisruptionTables)
RHI_SCENE_CONSTANT("shift", "shift_idx", Int, 0, Disruption)
RHI_SCENE_CONSTANT("shift", "shift_fac", Float, 0, Disruption)
RHI_SCENE_CONSTANT("shift", "lerp_fac", Float, 0, Disruption)
RHI_SCENE_CONSTANT("shift", "white_table", Float, 192, DisruptionTables)
RHI_SCENE_CONSTANT("shift", "white_fac", Float, 0, Disruption)
RHI_SCENE_TEXTURE("shift", "tex", PostTexture, PostSampler, 0)

RHI_SCENE_TEXTURE("backdrop", "photo", PostTexture, PostSampler, 0)
RHI_SCENE_TEXTURE("backdrop", "noise_tex", PostAuxTexture, PostAuxSampler, 1)
RHI_SCENE_CONSTANT("backdrop", "strength", Float, 0, Backdrop)
RHI_SCENE_CONSTANT("backdrop", "time", Float, 0, Backdrop)
RHI_SCENE_CONSTANT("backdrop", "view_width", Float, 0, Backdrop)
RHI_SCENE_CONSTANT("backdrop", "view_height", Float, 0, Backdrop)
