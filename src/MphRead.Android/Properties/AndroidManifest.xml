<?xml version="1.0" encoding="utf-8"?>
<!-- The server list is UDP to the directory and to each server, so the app
     needs the network. Nothing else is asked for: this build has no files to
     read off the device and nothing to write outside its own data directory. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <!-- The renderer is ES 3.0: vertex array objects, unsigned int indices and
       the 300 es shaders in Mods/Render/EsShaders.cs. A device without it
       cannot run the match half at all, so it should not see the app. -->
  <uses-feature android:glEsVersion="0x00030000" android:required="true" />
  <application android:label="Fruity Prime" android:allowBackup="true"
               android:supportsRtl="true" android:hardwareAccelerated="true"
               android:icon="@mipmap/appicon" android:roundIcon="@mipmap/appicon" />
</manifest>
